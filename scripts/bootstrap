#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: scripts/bootstrap [options]

Sets up a fresh clone for local development (or picks up where it left off):
  - renames template identifiers
  - copies config/env.example -> .env (if missing)
  - installs JS + Python dependencies
  - starts/stops Docker Compose profiles
  - runs lint and tests
  - optionally prompts for deployment variables (scripts/configure-deploy)

When run with no arguments and a TTY, prompts interactively for each option.
Deployment variables are optional; local dev only needs .env from the example.

Options:
  --project-name <name>  Project slug for renaming (e.g. my-app)
  --skip-rename      Skip template renaming
  --skip-install     Skip dependency installation
  --skip-compose     Skip Docker Compose startup/shutdown
  --keep-compose     Leave Compose running after bootstrap
  --skip-lint        Skip lint checks
  --skip-tests       Skip tests
  --profiles <list>  Comma-separated Compose profiles (default: db,storage,email)
  -h, --help         Show this help
EOF
}

SKIP_INSTALL=false
SKIP_COMPOSE=false
KEEP_COMPOSE=false
SKIP_LINT=false
SKIP_TESTS=false
SKIP_RENAME=false
PROJECT_NAME=""
COMPOSE_PROFILES="db,storage,email"
HAD_ARGS=$#

while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-install)
      SKIP_INSTALL=true
      shift
      ;;
    --skip-compose)
      SKIP_COMPOSE=true
      shift
      ;;
    --keep-compose)
      KEEP_COMPOSE=true
      shift
      ;;
    --skip-lint)
      SKIP_LINT=true
      shift
      ;;
    --skip-tests)
      SKIP_TESTS=true
      shift
      ;;
    --skip-rename)
      SKIP_RENAME=true
      shift
      ;;
    --project-name)
      PROJECT_NAME="${2:-}"
      shift 2
      ;;
    --profiles)
      COMPOSE_PROFILES="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# Interactive mode: no args and a TTY → prompt for each option (optional values)
INTERACTIVE=false
if [[ $HAD_ARGS -eq 0 && -t 0 ]]; then
  INTERACTIVE=true
fi

prompt_yn() {
  local prompt="$1" default="$2"
  local choice
  if [[ "$default" == "y" ]]; then
    read -r -p "${prompt} [Y/n]: " choice
    choice="${choice:-y}"
  else
    read -r -p "${prompt} [y/N]: " choice
    choice="${choice:-n}"
  fi
  [[ "$choice" =~ ^[yY] ]]
}

prompt_value() {
  local -n ref=$1
  local prompt="$2" default="$3"
  read -r -p "${prompt} [${default}]: " ref
  ref="${ref:-$default}"
}

if [[ "$INTERACTIVE" == "true" ]]; then
  echo "Bootstrap options (press Enter to accept default, each step can be skipped if already done)."
  echo ""
  prompt_value PROJECT_NAME "Project name (kebab-case, leave empty to skip rename)" ""
  prompt_yn "Skip template rename?" "n" && SKIP_RENAME=true || SKIP_RENAME=false
  prompt_yn "Skip dependency install?" "n" && SKIP_INSTALL=true || SKIP_INSTALL=false
  prompt_yn "Skip Docker Compose?" "n" && SKIP_COMPOSE=true || SKIP_COMPOSE=false
  prompt_yn "Keep Compose running after bootstrap?" "n" && KEEP_COMPOSE=true || KEEP_COMPOSE=false
  prompt_value COMPOSE_PROFILES "Compose profiles (comma-separated)" "db,storage,email"
  prompt_yn "Skip lint?" "n" && SKIP_LINT=true || SKIP_LINT=false
  prompt_yn "Skip tests?" "n" && SKIP_TESTS=true || SKIP_TESTS=false
  echo ""
fi

log() {
  printf "==> %s\n" "$1"
}

warn() {
  printf "warning: %s\n" "$1" >&2
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

cd "$ROOT_DIR"

require_cmd uv

current_project_name="$(python3 - <<'PY'
from __future__ import annotations

import json
from pathlib import Path

path = Path("package.json")
if not path.exists():
    print("")
else:
    print(json.loads(path.read_text(encoding="utf-8")).get("name", ""))
PY
)"

# --- Rename (pick up: skip if already renamed or no name given) ---
if [[ "$SKIP_RENAME" == "true" ]]; then
  log "Skipping template rename"
elif [[ "$current_project_name" != "fullstack-template" ]]; then
  log "Template already renamed ($current_project_name)"
elif [[ -z "$PROJECT_NAME" ]]; then
  if [[ "$INTERACTIVE" == "true" ]]; then
    log "Skipping template rename (no project name)"
  else
    echo "Missing --project-name in non-interactive mode." >&2
    exit 1
  fi
else
  log "Renaming template to: $PROJECT_NAME"
  ./scripts/rename-template "$PROJECT_NAME"
fi

# --- .env (pick up: skip if already present) ---
if [[ ! -f ".env" ]]; then
  log "Copying config/env.example -> .env"
  cp "config/env.example" ".env"
else
  log ".env already exists"
fi

# --- Venv (pick up: skip if already present) ---
VENV_DIR="$ROOT_DIR/.venv"
if [[ ! -d "$VENV_DIR" ]]; then
  log "Creating virtual environment at .venv"
  uv venv "$VENV_DIR"
else
  log ".venv already exists"
fi

# Activate the virtual environment for subsequent commands
export VIRTUAL_ENV="$VENV_DIR"
export PATH="$VENV_DIR/bin:$PATH"
hash -r 2>/dev/null || true

# --- Install (pick up: in interactive mode, offer to skip if deps look installed) ---
RUN_INSTALL=true
if [[ "$SKIP_INSTALL" == "false" && "$INTERACTIVE" == "true" && -d "node_modules" && -d "$VENV_DIR" ]]; then
  if ! prompt_yn "Deps already installed. Reinstall?" "n"; then
    RUN_INSTALL=false
  fi
fi
if [[ "$SKIP_INSTALL" == "false" && "$RUN_INSTALL" == "true" ]]; then
  require_cmd pnpm
  log "Installing JS dependencies"
  pnpm install
  log "Installing API dependencies"
  uv pip install -e "apps/api[dev]"
  if [[ -d ".git" ]]; then
    log "Installing pre-commit hooks"
    python -m pre_commit install --install-hooks || warn "pre-commit hook install failed"
  else
    warn "No .git directory found; skipping pre-commit hook install"
  fi
elif [[ "$SKIP_INSTALL" == "true" ]]; then
  log "Skipping dependency install"
fi

compose_started=false
compose_args=()
IFS=',' read -r -a profile_list <<< "$COMPOSE_PROFILES"
for profile in "${profile_list[@]}"; do
  profile_trimmed="$(echo "$profile" | xargs)"
  if [[ -n "$profile_trimmed" ]]; then
    compose_args+=("--profile" "$profile_trimmed")
  fi
done

cleanup_compose() {
  if [[ "$compose_started" == "true" && "$KEEP_COMPOSE" == "false" ]]; then
    log "Stopping Docker Compose"
    docker compose "${compose_args[@]}" down
  fi
}

# --- Compose (pick up: in interactive mode, offer to skip if already up) ---
START_COMPOSE=true
if [[ "$SKIP_COMPOSE" == "false" && "$INTERACTIVE" == "true" ]]; then
  if docker compose "${compose_args[@]}" ps -q 2>/dev/null | grep -q .; then
    if ! prompt_yn "Compose may already be running. Start anyway?" "n"; then
      START_COMPOSE=false
    fi
  fi
fi
if [[ "$SKIP_COMPOSE" == "false" && "$START_COMPOSE" == "true" ]]; then
  require_cmd docker
  log "Starting Docker Compose profiles: $COMPOSE_PROFILES"
  docker compose "${compose_args[@]}" up -d --build
  compose_started=true
  if [[ "$KEEP_COMPOSE" == "false" ]]; then
    trap cleanup_compose EXIT
  fi
elif [[ "$SKIP_COMPOSE" == "true" ]]; then
  log "Skipping Docker Compose"
fi

if [[ "$SKIP_LINT" == "false" ]]; then
  log "Running lint"
  pnpm lint
fi

if [[ "$SKIP_TESTS" == "false" ]]; then
  log "Running tests"
  pnpm test
fi

# Optional: configure deployment variables (interactive only; local dev can skip)
if [[ "$INTERACTIVE" == "true" ]]; then
  if prompt_yn "Configure deployment variables (writes .env.production)?" "n"; then
    ./scripts/configure-deploy
  fi
fi

if [[ -d ".git" ]]; then
  log "To create a development branch: ./scripts/init-branches"
fi

if [[ "$SKIP_COMPOSE" == "false" && "$KEEP_COMPOSE" == "true" ]]; then
  log "Compose left running (use: pnpm dev:down)"
fi
