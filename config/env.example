# Example environment variables (copy to your own local env file later)

# API Application Settings
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# API CORS (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000

# API JWT Settings
JWT_SECRET=dev-change-me
JWT_ISSUER=fullstack-template
JWT_AUDIENCE=fullstack-template
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (for future use - can use DATABASE_URL or individual POSTGRES_* vars)
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Storage providers (to be implemented)
S3_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GCS_BUCKET=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=

# Email (to be implemented)
EMAIL_FROM=no-reply@example.com
